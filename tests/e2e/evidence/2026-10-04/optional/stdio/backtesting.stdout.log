r"},{"type":"null"}],"default":null},"z_score_threshold":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null},"breakout_factor":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_run_backtest","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Run Backtest"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Grid-search a strategy's parameters (sma_cross, rsi, macd, bollinger, or momentum only).","inputSchema":{"properties":{"symbol":{"type":"string"},"strategy":{"default":"sma_cross","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"optimization_metric":{"default":"sharpe_ratio","type":"string"},"optimization_level":{"default":"medium","type":"string"},"top_n":{"default":10,"type":"integer"}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_optimize_strategy","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Optimize Strategy"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Roll a strategy forward through repeated optimize/test windows to gauge robustness.","inputSchema":{"properties":{"symbol":{"type":"string"},"strategy":{"default":"sma_cross","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"window_size":{"default":252,"type":"integer"},"step_size":{"default":63,"type":"integer"}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_walk_forward_analysis","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Walk Forward Analysis"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Bootstrap-resample a backtest's trades to estimate a return/drawdown distribution.","inputSchema":{"properties":{"symbol":{"type":"string"},"strategy":{"default":"sma_cross","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"num_simulations":{"default":1000,"type":"integer"},"fast_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"slow_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_monte_carlo_simulation","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Monte Carlo Simulation"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Backtest multiple strategies on the same symbol and rank them.","inputSchema":{"properties":{"symbol":{"type":"string"},"strategies":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_compare_strategies","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Compare Strategies"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"List every available rule-based strategy template with its default parameters.","inputSchema":{"properties":{},"type":"object","additionalProperties":false},"name":"backtesting_list_strategies","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting List Strategies"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Backtest one strategy across multiple symbols and aggregate portfolio-level\nmetrics.\n\nEach symbol is backtested independently (no combined equity curve, no\ncross-symbol correlation). `total_return`/`average_sharpe` are per-symbol\naverages; `max_drawdown` is the worst (most negative) constituent\ndrawdown, not a joint-portfolio calculation.","inputSchema":{"properties":{"symbols":{"items":{"type":"string"},"type":"array"},"strategy":{"default":"sma_cross","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"initial_capital":{"default":10000.0,"type":"number"},"position_size":{"default":0.1,"type":"number"},"fast_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"slow_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null}},"required":["symbols"],"type":"object","additionalProperties":false},"name":"backtesting_backtest_portfolio","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Backtest Portfolio"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Run a backtest using an ML-enhanced strategy (ml_predictor, adaptive, ensemble, or\nregime_aware).","inputSchema":{"properties":{"symbol":{"type":"string"},"strategy_type":{"default":"ml_predictor","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"initial_capital":{"default":10000.0,"type":"number"},"train_ratio":{"default":0.8,"type":"number"},"model_type":{"default":"random_forest","type":"string"},"n_estimators":{"default":100,"type":"integer"},"max_depth":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"learning_rate":{"default":0.01,"type":"number"},"adaptation_method":{"default":"gradient","type":"string"}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_run_ml_strategy_backtest","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Run Ml Strategy Backtest"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Train a random-forest ML predictor model for trading signals.","inputSchema":{"properties":{"symbol":{"type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"model_type":{"default":"random_forest","type":"string"},"target_periods":{"default":5,"type":"integer"},"return_threshold":{"default":0.02,"type":"number"},"n_estimators":{"default":100,"type":"integer"},"max_depth":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"min_samples_split":{"default":2,"type":"integer"}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_train_ml_predictor","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Train Ml Predictor"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Analyze market regimes (bear/sideways/bull) for a symbol using ML methods.\n\n`method=\"hmm\"` (the default) fits an `sklearn.mixture.GaussianMixture`,\nnot a genuine Hidden Markov Model -- the name is kept for backward\ncompatibility. `method=\"kmeans\"` is real k-means clustering;\n`method=\"threshold\"` is a zero-model rule-based classifier. The returned\n`method` field reports what was actually used, which can differ from the\nrequest if there wasn't enough history to fit a statistical model\n(silently falls back to \"threshold\"). Each history entry's\n`probabilities` are the fitted model's real posterior when one exists,\notherwise an honest one-hot at the assigned regime -- never a fabricated\nuniform distribution.","inputSchema":{"properties":{"symbol":{"type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"method":{"default":"hmm","type":"string"},"n_regimes":{"default":3,"type":"integer"},"lookback_period":{"default":50,"type":"integer"}},"required":["symbol"],"type":"object","additionalProperties":false},"name":"backtesting_analyze_market_regimes","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Analyze Market Regimes"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Create and backtest a weighted ensemble of base strategies across multiple symbols.","inputSchema":{"properties":{"symbols":{"items":{"type":"string"},"type":"array"},"base_strategies":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null},"weighting_method":{"default":"performance","type":"string"},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"initial_capital":{"default":10000.0,"type":"number"}},"required":["symbols"],"type":"object","additionalProperties":false},"name":"backtesting_create_strategy_ensemble","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Create Strategy Ensemble"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Parse a natural-language strategy description into a strategy type and parameters,\nusing the configured BYOK LLM when available and degrading to zero-dependency keyword\nparsing otherwise (see `strategies.parser.StrategyParser.parse_with_llm`).","inputSchema":{"properties":{"description":{"type":"string"}},"required":["description"],"type":"object","additionalProperties":false},"name":"backtesting_parse_strategy","outputSchema":{"type":"object","additionalProperties":true},"title":"Backtesting Parse Strategy"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":