":null}},"required":["entry_id","exit_price"],"type":"object","additionalProperties":false},"name":"portfolio_journal_close_trade","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Journal Close Trade"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"RSI reading and signal label for `ticker`.\n\n`period`/`days` left `None` fall back to `TechnicalSettings` defaults.","inputSchema":{"properties":{"ticker":{"type":"string"},"period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"days":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null}},"required":["ticker"],"type":"object","additionalProperties":false},"name":"technical_get_rsi_analysis","outputSchema":{"type":"object","additionalProperties":true},"title":"Technical Get Rsi Analysis"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"MACD reading, signal label, and crossover state for `ticker`.\n\nAny period left `None` falls back to its `TechnicalSettings` default.","inputSchema":{"properties":{"ticker":{"type":"string"},"fast_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"slow_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"signal_period":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"days":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null}},"required":["ticker"],"type":"object","additionalProperties":false},"name":"technical_get_macd_analysis","outputSchema":{"type":"object","additionalProperties":true},"title":"Technical Get Macd Analysis"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Observed low/high range for `ticker`, a support/resistance heuristic.\n\n`days` selects calendar history; `None` uses `sr_lookback` bars (default 30).\nReturns the method and number of bars used, without synthetic price levels.","inputSchema":{"properties":{"ticker":{"type":"string"},"days":{"anyOf"