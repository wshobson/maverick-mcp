{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"limit":{"default":20,"type":"integer"}},"type":"object","additionalProperties":false},"name":"screening_get_by_criteria","outputSchema":{"type":"object","additionalProperties":true},"title":"Screening Get By Criteria"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"readOnlyHint":false},"description":"Recompute one screen (or all three when `screen` is omitted) and persist it.\n\nAlways returns a `screen name -> ScreenRun` mapping under `results`, even\nfor a single explicit screen, so callers never need to branch on shape.\nScreens only symbols already known locally; with none, returns an error\nthat says how to add them.","inputSchema":{"properties":{"screen":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null}},"type":"object","additionalProperties":false},"name":"screening_run_screens","outputSchema":{"type":"object","additionalProperties":true},"title":"Screening Run Screens"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Full portfolio snapshot: every position plus live-priced metrics.","inputSchema":{"properties":{"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_get_my_portfolio","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Get My Portfolio"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"ATR-based position sizing/stop/target for `ticker`, plus an\nexisting-position block if `portfolio_name` already holds it.","inputSchema":{"properties":{"ticker":{"type":"string"},"risk_level":{"default":50.0,"type":"number"},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"required":["ticker"],"type":"object","additionalProperties":false},"name":"portfolio_risk_adjusted_analysis","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Risk Adjusted Analysis"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Side-by-side comparison of `tickers`, or of `portfolio_name`'s\nholdings when `tickers` is omitted (requires >= 2 holdings).","inputSchema":{"properties":{"tickers":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null},"days":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_compare_tickers","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Compare Tickers"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Correlation matrix and diversification metrics for `tickers`, or for\n`portfolio_name`'s holdings when `tickers` is omitted (requires >= 2\nholdings).","inputSchema":{"properties":{"tickers":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null},"days":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_correlation_analysis","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Correlation Analysis"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Full risk dashboard for `portfolio_name`: total value, sector\nconcentration, parametric VaR (95/99), and total unrealized P&L.","inputSchema":{"properties":{"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_get_risk_dashboard","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Get Risk Dashboard"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Pre-trade risk check: current vs. projected portfolio risk if\n`shares` of `ticker` were added at `entry_price`.","inputSchema":{"properties":{"ticker":{"type":"string"},"shares":{"type":"number"},"entry_price":{"type":"number"},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"required":["ticker","shares","entry_price"],"type":"object","additionalProperties":false},"name":"portfolio_check_position_risk","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Check Position Risk"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Position size scaled by the current SPY-detected market regime\n(bull = full risk, choppy/transitional = 75%, bear = 50%).","inputSchema":{"properties":{"account_size":{"type":"number"},"entry_price":{"type":"number"},"stop_loss":{"type":"number"},"risk_pct":{"default":2.0,"type":"number"}},"required":["account_size","entry_price","stop_loss"],"type":"object","additionalProperties":false},"name":"portfolio_get_regime_adjusted_sizing","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Get Regime Adjusted Sizing"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Current risk alerts for `portfolio_name`: sector concentration,\noversized positions, and portfolio drawdown threshold breaches.","inputSchema":{"properties":{"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_get_risk_alerts","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Get Risk Alerts"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Intelligence brief for every symbol on a watchlist: notes, days on\nwatchlist, and the current price via market_data.","inputSchema":{"properties":{"watchlist_id":{"type":"integer"}},"required":["watchlist_id"],"type":"object","additionalProperties":false},"name":"portfolio_watchlist_brief","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Watchlist Brief"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"List saved watchlist IDs, names, and descriptions in creation order.","inputSchema":{"properties":{},"type":"object","additionalProperties":false},"name":"portfolio_watchlist_list","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Watchlist List"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"List journal trades, optionally filtered by symbol, status\n(open/closed), or strategy tag. Newest entry date first.","inputSchema":{"properties":{"symbol":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"status":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"strategy_tag":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"limit":{"default":50,"type":"integer"}},"type":"object","additionalProperties":false},"name":"portfolio_journal_list_trades","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Journal List Trades"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Full detail for a single trade by ID, including the side-aware\n`pnl_pct` (only populated once the trade is closed).","inputSchema":{"properties":{"entry_id":{"type":"integer"}},"required":["entry_id"],"type":"object","additionalProperties":false},"name":"portfolio_journal_review","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Journal Review"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"readOnlyHint":true},"description":"Strategy performance analytics. `compare=False` (default) returns\nwin/loss/expectancy/profit-factor for a single `strategy_tag`\n(required). `compare=True` returns every strategy ranked by expectancy\ndescending, absorbing legacy's separate `get_strategy_comparison` tool\ninto this one via the flag -- `strategy_tag` is ignored in that mode.","inputSchema":{"properties":{"strategy_tag":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"compare":{"default":false,"type":"boolean"}},"type":"object","additionalProperties":false},"name":"portfolio_get_strategy_performance","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Get Strategy Performance"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":false,"idempotentHint":false,"readOnlyHint":false},"description":"Add (or average into) a position in `portfolio_name`.","inputSchema":{"properties":{"ticker":{"type":"string"},"shares":{"type":"number"},"purchase_price":{"type":"number"},"purchase_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"notes":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"required":["ticker","shares","purchase_price"],"type":"object","additionalProperties":false},"name":"portfolio_add_position","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Add Position"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":true,"idempotentHint":false,"readOnlyHint":false},"description":"Remove `shares` from `ticker` (or the entire position when omitted).","inputSchema":{"properties":{"ticker":{"type":"string"},"shares":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"required":["ticker"],"type":"object","additionalProperties":false},"name":"portfolio_remove_position","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Remove Position"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":true,"idempotentHint":true,"readOnlyHint":false},"description":"Remove every position from `portfolio_name`. Requires `confirm=True`.","inputSchema":{"properties":{"confirm":{"default":false,"type":"boolean"},"user_id":{"default":"default","type":"string"},"portfolio_name":{"default":"My Portfolio","type":"string"}},"type":"object","additionalProperties":false},"name":"portfolio_clear_portfolio","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Clear Portfolio"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":false,"idempotentHint":false,"readOnlyHint":false},"description":"Create a new named watchlist for tracking ticker symbols. The name\nmust be unique.","inputSchema":{"properties":{"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null}},"required":["name"],"type":"object","additionalProperties":false},"name":"portfolio_watchlist_create","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Watchlist Create"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":false,"idempotentHint":false,"readOnlyHint":false},"description":"Add a ticker symbol to an existing watchlist. Repeat calls for the\nsame symbol add another entry rather than replacing it.","inputSchema":{"properties":{"watchlist_id":{"type":"integer"},"symbol":{"type":"string"},"notes":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null}},"required":["watchlist_id","symbol"],"type":"object","additionalProperties":false},"name":"portfolio_watchlist_add","outputSchema":{"type":"object","additionalProperties":true},"title":"Portfolio Watchlist Add"},{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"destructiveHint":true,"idempotentHint":true,"readOnlyHint":false},"description":"Remove a ticker symbol from a watchlist.","inputSchema":{"properties":{"